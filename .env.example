# Se completa a medida que se usa cada servicio. Los valores van en .env.local (ignorado por git) y en las variables de Vercel o los
# secretos de Supabase.

# Públicas por diseño: terminan en el navegador. Lo que protege los datos es la seguridad por filas de la base, no estas claves.
# En local salen de `supabase status` (API_URL y ANON_KEY).
VITE_SUPABASE_URL=
VITE_TURNSTILE_SITE_KEY=
VITE_SUPABASE_ANON_KEY=

# Solo del lado del servidor (Edge Functions): nunca con prefijo VITE_ ni en el navegador
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

TURNSTILE_SECRET_KEY=
BOOKING_ALLOWED_ORIGINS=
BOOKING_ALLOWED_HOSTNAMES=
