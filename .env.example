# Se completa a medida que se usa cada servicio. Los valores van en .env.local (ignorado por git) y en las variables de Vercel o los
# secretos de Supabase.

# Públicas por diseño: terminan en el navegador. Lo que protege los datos es la seguridad por filas de la base, no estas claves.
# En local salen de `supabase status` (API_URL y ANON_KEY).
VITE_SUPABASE_URL=
VITE_TURNSTILE_SITE_KEY=
VITE_SUPABASE_ANON_KEY=

# Solo del lado del servidor (Edge Functions): nunca con prefijo VITE_ ni en el navegador
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

TURNSTILE_SECRET_KEY=
BOOKING_ALLOWED_ORIGINS=
BOOKING_ALLOWED_HOSTNAMES=
# URL canónica de la aplicación y URL de retorno de Mercado Pago
APP_URL=https://cale.com.ar

# Web Push: pública en el cliente, privada solo en Edge Functions
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Mercado Pago — prueba. Nunca uses estas variables con credenciales de producción.
MP_PUBLIC_KEY_TEST=
MP_ACCESS_TOKEN_TEST=
MP_WEBHOOK_SECRET_TEST=

# Mercado Pago — producción. Al activar producción, estas variables tienen prioridad sobre las de prueba.
# MP_ACCESS_TOKEN nunca se expone al navegador.
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
