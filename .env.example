# Se completa a medida que se usa cada servicio. Los valores van en .env.local (ignorado por git) y en las variables de Vercel o los
# secretos de Supabase.

# Públicas por diseño: terminan en el navegador. Lo que protege los datos es la seguridad por filas de la base, no estas claves.
# En local salen de `supabase status` (API_URL y ANON_KEY).
VITE_SUPABASE_URL=
VITE_TURNSTILE_SITE_KEY=
VITE_SUPABASE_ANON_KEY=

# Solo del lado del servidor (Edge Functions): nunca con prefijo VITE_ ni en el navegador
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

TURNSTILE_SECRET_KEY=

# Por entorno (secretos de las Edge Functions de cada proyecto de Supabase). Sin estas variables rigen los valores de producción
# (supabase/functions/_shared/environment.ts): un proyecto de desarrollo TIENE que declararlas. Una variable declarada y vacía es un
# error de configuración y no vuelve a producción. Los orígenes son esquema + dominio, sin ruta ni barra final.
# Ejemplo cale-dev: ALLOWED_ORIGINS=https://dev.cale.com.ar,http://localhost:5174 · APP_URL=https://dev.cale.com.ar
#   BOOKING_ALLOWED_ORIGINS=https://dev.cale.com.ar,http://localhost:5174 · BOOKING_ALLOWED_HOSTNAMES=dev.cale.com.ar,localhost
# Orígenes que pueden llamar a las funciones del panel (CORS)
ALLOWED_ORIGINS=
# Orígenes y dominios (el widget de Turnstile informa el dominio) de la reserva pública
BOOKING_ALLOWED_ORIGINS=
BOOKING_ALLOWED_HOSTNAMES=
# URL de la aplicación del entorno: URL de retorno de Mercado Pago
APP_URL=

# Vault de cada proyecto (no son variables de entorno): cale_push_job_secret (igual a PUSH_JOB_SECRET) y cale_functions_base_url
# (https://<ref>.supabase.co/functions/v1) que usa el job del push. Ver docs/migrations.md.
PUSH_JOB_SECRET=

# Web Push: pública en el cliente, privada solo en Edge Functions
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Mercado Pago — prueba. Nunca uses estas variables con credenciales de producción.
MP_PUBLIC_KEY_TEST=
MP_ACCESS_TOKEN_TEST=
MP_WEBHOOK_SECRET_TEST=

# Mercado Pago — producción. Al activar producción, estas variables tienen prioridad sobre las de prueba.
# MP_ACCESS_TOKEN nunca se expone al navegador.
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
